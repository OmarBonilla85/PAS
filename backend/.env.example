# Plantilla de variables de entorno.
# Copia este archivo a `.env` (en la raíz del proyecto) y ajusta los valores
# reales. Nunca versiones el archivo `.env` con credenciales.

# --- Conexión a PostgreSQL ---
# Variables discretas usadas por backend/config.py
DB_USER=usuario
DB_PASSWORD=cambiar_esta_contrasena
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pas_data

# Cadena de conexión completa (equivalente a las variables anteriores)
DATABASE_URL=postgresql://usuario:cambiar_esta_contrasena@127.0.0.1:5432/pas_data

# --- Servidor de la API ---
HOST=127.0.0.1
PORT=8000
